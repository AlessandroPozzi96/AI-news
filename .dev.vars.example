# Local values for `npm run dry-run` and `npm run pipeline`. In CI these come from GitHub secrets/variables.
ANTHROPIC_API_KEY=
RESEND_API_KEY=
GITHUB_TOKEN=

# Needed only to run the pipeline locally against the real database
CF_ACCOUNT_ID=
CF_API_TOKEN=
D1_DATABASE_ID=
UNSUBSCRIBE_SECRET=
PUBLIC_BASE_URL=https://ai-news.devagents-weekly-news.workers.dev
MAIL_FROM=Dev Agents Weekly <onboarding@resend.dev>
ADMIN_EMAIL=

# Dashboard login token (Worker secret: npx wrangler secret put ADMIN_TOKEN)
ADMIN_TOKEN=

# "Envoyer maintenant" (Worker secret: npx wrangler secret put GH_DISPATCH_TOKEN). Fine-grained GitHub token
# limited to this repository, permission Actions: read and write. The repo itself is set in wrangler.jsonc (GITHUB_REPO).
GH_DISPATCH_TOKEN=
