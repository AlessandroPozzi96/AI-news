{
  "name": "ai-news",
  "version": "0.1.0",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc",
    "lint": "eslint .",
    "db:migrate:local": "wrangler d1 migrations apply ai-news --local",
    "db:migrate:remote": "wrangler d1 migrations apply ai-news --remote",
    "collect": "tsx --env-file-if-exists=.dev.vars scripts/collect.ts",
    "dry-run": "tsx --env-file-if-exists=.dev.vars scripts/dry-run.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "fast-xml-parser": "^5.11.2",
    "hono": "^4.13.16",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@cloudflare/workers-types": "^5.20261101.1",
    "@types/node": "^22.0.0",
    "eslint": "^9.39.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.0",
    "wrangler": "^4.156.0"
  },
